# Copy this file to .env and fill in real values. Never commit .env.

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=raw

# Azure SQL Database
SQL_SERVER=yourserver.database.windows.net
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
